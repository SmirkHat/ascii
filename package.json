{
  "name": "ascii-smht",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "generate-figlet-fonts": "node scripts/generate-figlet-fonts.mjs",
    "convert-pixel-fonts": ".venv-fonts/bin/python scripts/ttf_to_flf.py && node scripts/generate-font-previews.mjs",
    "generate-font-previews": "node scripts/generate-font-previews.mjs",
    "build": "vite build && node scripts/build-static.mjs",
    "start": "srvx --prod -s dist/client dist/server/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "figlet": "^1.11.3",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "latest",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/figlet": "^1.7.0",
    "@types/node": "^24",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.20.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.1",
    "srvx": "^0.12.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
